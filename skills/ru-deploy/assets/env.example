# ============================================================
# ru-deploy — пример переменных окружения (ТОЛЬКО ПЛЕЙСХОЛДЕРЫ)
# Никогда не коммить реальные ключи. Все секреты — на сервере.
# ============================================================

# ---- 0. ДОСТУП К СЕРВЕРУ (локальный файл .ru-deploy/credentials.env) ----
# Эти значения задаёт пользователь при создании ВМ в Cloud.ru. Агент сохраняет
# их в .ru-deploy/credentials.env и добавляет .ru-deploy/ в .gitignore проекта,
# чтобы они НЕ попали в репозиторий. Подробно — SKILL.md → «Доступы к серверу».
# RU_HOST=176.123.160.180        # публичный IP виртуалки
# RU_USER=admin                  # логин (тот, что задал пользователь; часто admin)
# RU_PASS=ПАРОЛЬ-ОТ-ВМ           # пароль (вход по паролю; требует утилиту sshpass)
# RU_DOMAIN=ТВОЙ-IP.sslip.io     # домен (появляется на шаге 1)

# ---- 1. ФРОНТЕНД (.env в корне проекта, вшивается в сборку) ----
# Публичные значения. URL — твой домен, ключ — ANON_KEY, который напечатал
# server-setup.sh на шаге 2.
VITE_SUPABASE_URL=https://ТВОЙ-ДОМЕН.ru
VITE_SUPABASE_PUBLISHABLE_KEY=ВСТАВЬ-ANON-KEY-С-ШАГА-2

# ============================================================
# Ниже — переменные, которые живут ТОЛЬКО на сервере, в файле
# /opt/supabase/docker/.env. В репозиторий их не кладём.
# ============================================================

# ---- 2. Платежи YooKassa (секреты edge-функций) ----
# Личный кабинет YooKassa → Настройки магазина
# YOOKASSA_SHOP_ID=000000
# YOOKASSA_SECRET_KEY=live_xxxxxxxxxxxxxxxxxxxx
# Публичные функции без JWT (вебхуки, которые зовут без токена) — через запятую.
# На self-hosted пометка `// verify_jwt = false` в коде НЕ работает; вместо неё —
# этот список, его читает патч-роутер functions-main.ts (см. backend-supabase.md).
# PUBLIC_FUNCTIONS=yookassa-webhook

# ---- 3. AI (пользователь настраивает сам, см. references/ai-provider.md) ----
# Пример для GigaChat:
# GIGACHAT_AUTH_KEY=xxxxxxxx
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ---- 4. Почта / SMTP (для сброса пароля, см. references/email-smtp.md) ----
# Self-host Supabase сам пробрасывает эти SMTP_* в GoTrue.
# Рекомендуется Selectel — 1000 писем/месяц бесплатно. Хост/порт известны заранее;
# логин (числовой) и API-key пользователь берёт из вкладки «Информация» ресурса.
# SMTP_ADMIN_EMAIL=noreply@ТВОЙ-ДОМЕН.ru
# SMTP_HOST=smtp.mail.selcloud.ru
# SMTP_PORT=1126                          # 1126 = STARTTLS (рекоменд.), 1127 = TLS/SSL
# SMTP_USER=9572                          # числовой логин ресурса Selectel
# SMTP_SENDER_NAME=Название проекта
# API-key храни в .ru-deploy/credentials.env (не в репозитории!):
# SELECTEL_SMTP_PASS=api-key-из-панели-Selectel
